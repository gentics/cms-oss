{
  "name": "andp-ma-formgen",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "copy-mock-files": "copyfiles -f \"../../packages/feature-formgen/src/mock-files/*\" ./public/mock-files",
    "prestart": "npm run copy-mock-files",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "preweb": "npm run copy-mock-files",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "prebuild": "npm run copy-mock-files",
    "build": "expo export --platform web",
    "postbuild": "copyfiles -f ../../node_modules/pdfjs-dist/build/pdf.worker.min.mjs ./dist/_expo/static/js/web/"
  },
  "dependencies": {
    "@andp/core": "*",
    "@andp/feature-formgen": "*",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-community/datetimepicker": "9.2.1",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "i18next": "^26.5.11",
    "lodash": "^4.18.1",
    "patch-package": "^8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "copyfiles": "2.4.1"
  },
  "private": true
}
