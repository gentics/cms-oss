<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gentics</groupId>
        <artifactId>cms</artifactId>
        <version>6.6.1-SNAPSHOT</version>
    </parent>

    <groupId>com.gentics.cms</groupId>
    <artifactId>cms-server</artifactId>

    <packaging>jar</packaging>

	<organization>
		<name>Gentics Software</name>
		<url>http://www.gentics.com/</url>
	</organization>
	<name>Gentics CMS Enterprise Server</name>
	<description>Gentics CMS Enterprise Server</description>
	<url>http://www.gentics.com</url>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/build.txt</include>
					<include>**/cms.build.properties</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<excludes>
					<exclude>**/build.txt</exclude>
					<exclude>**/cms.build.properties</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<?m2e ignore?>
						<id>unpack</id>
						<!-- The phase can be overwritten in order to skip this step. Somehow m2e does not care about the skip flag for this plugin. -->
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<!-- EE Custom-Tools which were build in the OSS Part -->
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-ui</artifactId>
									<classifier>custom-tools</classifier>
									<type>zip</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/classes/webroot/tools</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.cms</groupId>
									<artifactId>formgen</artifactId>
									<type>zip</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/classes/webroot</outputDirectory>
								</artifactItem>
							</artifactItems>
							<includes>**/*</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<!-- Run shade goal on package phase -->
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<manifestEntries>
										<Main-Class>com.gentics.contentnode.server.Runner</Main-Class>
										<!-- The Implementation-Vendor and Implementation-Version are necessary for the embedded ImageIO to work properly -->
										<Implementation-Vendor>Gentics Software</Implementation-Vendor>
										<Implementation-Version>${project.version}</Implementation-Version>
									</manifestEntries>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.glassfish.hk2</groupId>
				<artifactId>hk2-inhabitant-generator</artifactId>
				<version>3.0.3</version>
				<executions>
					<execution>
						<goals>
							<goal>generate-inhabitants</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.gentics</groupId>
				<artifactId>dependency-reporting-plugin</artifactId>
				<executions>
					<execution>
						<id>java-transform</id>
						<goals>
							<goal>java-transform</goal>
						</goals>
						<configuration>
							<reportFile>../target/dependency-updates-aggregate-report.xml</reportFile>
							<componentName>CMS EE</componentName>
							<moduleName>Java Backend</moduleName>
							<staticInput>${project.basedir}/src/static_dependencies.json</staticInput>
							<ignoredNames>
								<ignoredName>com\.gentics\.cms-oss:.*</ignoredName>
								<ignoredName>com\.gentics\.cms:.*</ignoredName>
								<ignoredName>org\.alohaeditor:alohaeditor</ignoredName>
							</ignoredNames>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<?m2e ignore?>
						<id>make-report-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<appendAssemblyId>true</appendAssemblyId>
							<descriptors>
								<descriptor>report-assembly.xml</descriptor>
							</descriptors>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.swagger.core.v3</groupId>
				<artifactId>swagger-maven-plugin-jakarta</artifactId>
				<version>${swagger.version}</version>
				<configuration>
					<resourcePackages>
						<resourcePackage>com.gentics.contentnode.rest.resource</resourcePackage>
					</resourcePackages>
					<outputPath>${basedir}/src/main/resources/webroot/openapi/</outputPath>
					<outputFileName>openapi</outputFileName>
					<outputFormat>JSONANDYAML</outputFormat>
					<prettyPrint>TRUE</prettyPrint>
					<configurationFilePath>${project.build.outputDirectory}/openapiconfig.yaml</configurationFilePath>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>resolve</goal>
						</goals>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>jakarta.ws.rs</groupId>
						<artifactId>jakarta.ws.rs-api</artifactId>
						<version>3.1.0</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.gentics.cms</groupId>
                <artifactId>cms-bom</artifactId>
                <type>pom</type>
                <scope>import</scope>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Internal Dependencies -->
        <dependency>
            <groupId>com.gentics.cms-oss</groupId>
            <artifactId>cms-oss-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-contentstaging-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-linkchecker-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-search-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-keycloak</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-cluster-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-forms-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-multichannelling-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms-oss</groupId>
            <artifactId>cms-ui</artifactId>
            <classifier>custom-tools</classifier>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>cms-translation-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gentics.cms</groupId>
            <artifactId>formgen</artifactId>
            <type>zip</type>
			<scope>provided</scope>
        </dependency>

        <!--Test dependencies -->
        <dependency>
            <groupId>com.gentics.cms-oss</groupId>
            <artifactId>cms-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.gentics</groupId>
            <artifactId>generic-testutils</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>maven.gentics.com</id>
            <name>Gentics Maven Repository</name>
            <url>https://maven.gentics.com/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
