# GenAIx dev proxy (vite.config.ts). The Vite dev server reads these and adds the token and
# subject to every /genaix/api/v1 request. They have no VITE_ prefix, so they never reach the
# browser. Copy to .env.local to override the defaults.
#
# The values below are the defaults: the local GenAIx mock (`npm run mock:genaix`) and its
# fixture credentials. Never put a real installation token in a committed file.
GENAIX_API_URL=http://localhost:8123/api/v1
GENAIX_API_TOKEN=sk_gnx_mock
GENAIX_SUBJECT=sub_workspace_dev

# Development only: the CMS that `npm run dev` forwards /rest to, e.g. https://cms.example.com.
# No default: without it there is no /rest proxy, and the dev server answers the logged-in user
# (a fixed dev user, so there is no login) and the CMS API token request (a test token) itself
# (vite.config.ts). Not exposed to the browser.
CMS_PROXY_TARGET=

# Browser-visible (VITE_ prefix): the same-origin path of the CMS proxy that the UI sends every
# GenAIx request to. A path, not a secret, and never GenAIx itself. Default: /genaix/api/v1, which
# the dev proxy in vite.config.ts serves; a different value needs a matching proxy.
VITE_GENAIX_API_BASE=/genaix/api/v1
