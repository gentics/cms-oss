{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "types": [
            "vitest/globals"
        ]
    },
    "angularCompilerOptions": {
        "compilationMode": "full"
    },
    "include": [
        "src/**/*.ts",
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.ts",
        "src/**/*.d.ts"
    ]
}
