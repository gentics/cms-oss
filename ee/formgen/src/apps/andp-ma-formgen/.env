# If the app should be built/run in development mode.
# Default: false
#
DEV_MODE=false

# If the app should bundle in a mocked form and use it instead of loading actual form data.
# Default: false
#
MOCK_FORM=false

# Which base path the web version should be used, when building.
# Used for hosting under a sub-path.
# Default:
#
# APP_BASE_URL=
