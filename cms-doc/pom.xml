<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gentics</groupId>
		<artifactId>cms</artifactId>
		<version>6.5.3-SNAPSHOT</version>
	</parent>

	<groupId>com.gentics.cms</groupId>
	<artifactId>cms-doc</artifactId>
	<packaging>pom</packaging>

	<organization>
		<name>Gentics Software GmbH</name>
		<url>http://www.gentics.com/</url>
	</organization>

	<name>Gentics CMS - Documentation</name>
	<description>The contentnode-doc module</description>
	<url>http://www.gentics.com</url>

	<properties>
		<guides.exec.skip>false</guides.exec.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.gentics.cms-oss</groupId>
				<artifactId>cms-oss-bom</artifactId>
				<type>pom</type>
				<scope>import</scope>
				<version>${cms-oss.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-restapi</artifactId>
			<version>${cms-oss.version}</version>
			<classifier>sources</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-cluster-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-contentstaging-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-forms-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-linkchecker-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-multichannelling-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-search-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-translation-api</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>com.webcohesion.enunciate</groupId>
			<artifactId>enunciate-core-annotations</artifactId>
		</dependency>

		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-cluster-api</artifactId>
			<version>${project.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-contentstaging-api</artifactId>
			<version>${project.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-forms-api</artifactId>
			<version>${project.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-linkchecker-api</artifactId>
			<version>${project.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-multichannelling-api</artifactId>
			<version>${project.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-search-api</artifactId>
			<version>${project.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-translation-api</artifactId>
			<version>${project.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-oss-doc</artifactId>
			<version>${cms-oss.version}</version>
			<type>zip</type>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-oss-doc</artifactId>
			<version>${cms-oss.version}</version>
			<type>zip</type>
			<classifier>assets</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-oss-doc</artifactId>
			<version>${cms-oss.version}</version>
			<type>zip</type>
			<classifier>oss-content</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-restapi</artifactId>
			<version>${cms-oss.version}</version>
			<type>jar</type>
			<classifier>javadoc</classifier>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>com.webcohesion.enunciate</groupId>
				<artifactId>enunciate-maven-plugin</artifactId>
				<version>${enunciate.version}</version>
				<executions>
					<execution>
						<?m2e ignore?>
						<id>docs</id>
						<goals>
							<goal>docs</goal>
						</goals>
						<configuration>
							<docsDir>${project.build.directory}/restapi</docsDir>
							<docsSubdir>.</docsSubdir>
							<configFile>src/conf/enunciate.xml</configFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>dist</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<attach>true</attach>
							<appendAssemblyId>false</appendAssemblyId>
							<descriptors>
								<descriptor>${project.basedir}/src/assembly/doc-package.xml</descriptor>
							</descriptors>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>unpack-assets</id>
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-oss-doc</artifactId>
									<type>zip</type>
									<classifier>assets</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.basedir}/target/assets</outputDirectory>
								</artifactItem>
							</artifactItems>
							<includes>**/*</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
					<execution>
						<id>unpack-oss-content</id>
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-oss-doc</artifactId>
									<type>zip</type>
									<classifier>oss-content</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.basedir}/target/source</outputDirectory>
								</artifactItem>
							</artifactItems>
							<includes>**/*</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
					<execution>
						<id>unpack-oss-doc</id>
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-oss-doc</artifactId>
									<type>zip</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.basedir}/target</outputDirectory>
								</artifactItem>
							</artifactItems>
							<includes>gcnjsapi/**</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-sources</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.basedir}/target</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/src/main</directory>
									<includes>
										<include>**/*</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<configuration>
					<skip>${guides.exec.skip}</skip>
				</configuration>
				<executions>
					<execution>
						<phase>compile</phase>
						<id>invoke build</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>guides</executable>
							<workingDirectory>${project.basedir}/target</workingDirectory>
							<arguments>
								<argument>build</argument>
								<argument>--clean</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>check-links</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<phase>package</phase>
						<configuration>
							<skip>true</skip>
							<executable>linkchecker</executable>
							<arguments>
								<argument>--ignore-url="(.*\/gcnjsapi.*)|(.*\/contentnode-api.*)|(\/restapi\/.*)|(.*\/api-javadoc.*)|(.*\/restapi-javadoc.*)|(.*rails_guides_logo.*)"</argument>
								<argument>target/output/index.html</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
