<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gentics</groupId>
		<artifactId>cms</artifactId>
		<version>6.0.13-SNAPSHOT</version>
	</parent>

	<groupId>com.gentics.cms</groupId>
	<artifactId>cms-server</artifactId>

	<packaging>jar</packaging>

	<organization>
		<name>Gentics Software</name>
		<url>http://www.gentics.com/</url>
	</organization>
	<name>Gentics CMS OSS Server</name>
	<description>Gentics CMS OSS Server</description>
	<url>http://www.gentics.com</url>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/build.txt</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>**/build.txt</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<?m2e ignore?>
						<id>unpack</id>
						<!-- The phase can be overwritten in order to skip this step. Somehow m2e does not care about the skip flag for this plugin. -->
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<!-- Content.Node UI Link Checker CustomTool -->
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>ct-link-checker</artifactId>
									<type>zip</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/classes/webroot/tools/link-checker/</outputDirectory>
								</artifactItem>
							</artifactItems>
							<includes>**/*</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<!-- Run shade goal on package phase -->
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<manifestEntries>
										<Main-Class>com.gentics.contentnode.server.Runner</Main-Class>
										<!-- The Implementation-Vendor and Implementation-Version are necessary for the embedded ImageIO to work properly -->
										<Implementation-Vendor>Gentics Software</Implementation-Vendor>
										<Implementation-Version>${project.version}</Implementation-Version>
									</manifestEntries>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.glassfish.hk2</groupId>
				<artifactId>hk2-inhabitant-generator</artifactId>
				<version>3.0.3</version>
				<executions>
					<execution>
						<goals>
							<goal>generate-inhabitants</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.gentics.cms</groupId>
				<artifactId>cms-bom</artifactId>
				<type>pom</type>
				<scope>import</scope>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Internal Dependencies -->
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-oss-server</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-contentstaging-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-linkchecker-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-search-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-keycloak</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-cluster-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-forms-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-multichannelling-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>ct-link-checker</artifactId>
			<type>zip</type>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>maven.gentics.com</id>
			<name>Gentics Maven Repository</name>
			<url>https://maven.gentics.com/maven2</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
</project>
