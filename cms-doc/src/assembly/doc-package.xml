<assembly
		xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0 http://maven.apache.org/xsd/assembly-1.1.0.xsd">
	<id>doc</id>
	<formats>
		<format>zip</format>
	</formats>

	<dependencySets>
		<!-- Copy the OSS api javadoc -->
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/api-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<!--  groupId:artifactId:type:version[:classifier] -->
				<include>com.gentics.cms-oss:base-api:*:javadoc</include>
			</includes>
		</dependencySet>

		<!-- Copy the EE REST API javadoc -->
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/cluster-restapi-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<include>com.gentics.cms:cms-cluster-api:*:javadoc</include>
			</includes>
		</dependencySet>
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/contentstaging-restapi-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<include>com.gentics.cms:cms-contentstaging-api:*:javadoc</include>
			</includes>
		</dependencySet>
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/forms-restapi-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<include>com.gentics.cms:cms-forms-api:*:javadoc</include>
			</includes>
		</dependencySet>
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/linkchecker-restapi-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<include>com.gentics.cms:cms-linkchecker-api:*:javadoc</include>
			</includes>
		</dependencySet>
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/multichannelling-restapi-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<include>com.gentics.cms:cms-multichannelling-api:*:javadoc</include>
			</includes>
		</dependencySet>
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/search-restapi-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<include>com.gentics.cms:cms-search-api:*:javadoc</include>
			</includes>
		</dependencySet>

		<!-- Copy the OSS REST API JavaDoc. -->
		<dependencySet>
			<useStrictFiltering>true</useStrictFiltering>
			<outputDirectory>/restapi-javadoc</outputDirectory>
			<unpack>true</unpack>
			<includes>
				<include>com.gentics.cms-oss:cms-restapi:*:javadoc</include>
			</includes>
		</dependencySet>
	</dependencySets>

	<fileSets>
		<fileSet>
			<directory>${basedir}/target/output</directory>
			<outputDirectory>/</outputDirectory>
			<includes>
				<include>**</include>
			</includes>
		</fileSet>
		<fileSet>
			<directory>${basedir}/target/restapi</directory>
			<outputDirectory>/restapi</outputDirectory>
			<includes>
				<include>**/*</include>
			</includes>
		</fileSet>
		<fileSet>
			<directory>${basedir}/target/gcnjsapi</directory>
			<outputDirectory>/gcnjsapi</outputDirectory>
			<includes>
				<include>**/*</include>
			</includes>
		</fileSet>
	</fileSets>

	<includeBaseDirectory>false</includeBaseDirectory>
</assembly>
