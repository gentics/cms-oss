{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "types": ["node", "jquery"]
    },
    "include": ["src/**/*.ts", "testing/src/**/*.ts"],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "testing/src/**/*.spec.ts",
        "testing/src/**/*.test.ts",
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts"
    ]
}
